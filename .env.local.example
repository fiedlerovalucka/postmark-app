# Copy this file to .env.local for local development.
# In Vercel, add these same names under Project Settings > Environment Variables instead.

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From Anthropic: console.anthropic.com > API Keys
# This one has NO NEXT_PUBLIC_ prefix on purpose — it must stay server-side only,
# never sent to the browser. That is what keeps it safe.
ANTHROPIC_API_KEY=your-anthropic-api-key
